{
  "name": "daylog",
  "version": "1.0.0",
  "description": "Personal daily task tracker with activity tracking, habits, focus mode and an AI day planner.",
  "main": "src/main.js",
  "author": "Lance Agua",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder@25 --win"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "com.lanceagua.daylog",
    "productName": "DAYLOG",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DAYLOG"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false
  }
}